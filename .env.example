# .env.example — copy to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed.

# ── Admin Panel ───────────────────────────────────────────────────────────────
# SHA-256 hex hash of your admin passphrase.
# Generate it: echo -n "yourpassword" | sha256sum
#          or: https://emn178.github.io/online-tools/sha256.html
# Leave blank to allow any non-empty password in local dev (not for production).
VITE_ADMIN_PASSWORD_HASH=

# ── GitHub Publishing ─────────────────────────────────────────────────────────
# Personal Access Token with repo → Contents: Read and write permission.
# Used by the Admin Panel "Publish to GitHub" feature to commit projects.json.
# Leave blank to disable direct publishing (export JSON manually instead).
VITE_GITHUB_TOKEN=
